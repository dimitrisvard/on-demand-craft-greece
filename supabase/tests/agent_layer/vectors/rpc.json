      { "update": { "table": "agent_runs", "where": { "idempotency_key": "claim-1" },
        "set": { "status": "waiting_human", "approval_token_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "output": { "card_kind": "quote", "allowed_verbs": ["approve", "reject"] } } } },
      { "rpc": "agent_run_claim_approval", "args": { "p_token_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "p_human_action": {} } },
      { "rpc": "agent_run_claim_approval", "args": { "p_token_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "p_human_action": { "channel": "telegram", "actor": "telegram:42", "verb": "approve" } } },
      { "rpc": "agent_run_claim_approval", "args": { "p_token_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",

{
  "description": "microns: apex and HTTP redirects (docs/migration/PLAN.md S13; generated by scripts/phase3/redirect-rules.mjs)",
  "rules": [
    {
      "ref": "microns_http_to_https",
      "description": "HTTP to HTTPS, same host, path and query (status from the P0-3 baseline)",
      "expression": "(not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://\", http.host, raw.http.request.uri.path)"
          },
          "status_code": 308,
          "preserve_query_string": true
        }
      }
    },
    {
      "ref": "microns_apex_to_www",
      "description": "Apex to www, path and query kept (status from the P0-3 baseline)",
      "expression": "(http.host eq \"micronshub.eu\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://www.micronshub.eu\", raw.http.request.uri.path)"
          },
          "status_code": 308,
          "preserve_query_string": true
        }
      }
    }
  ]
}

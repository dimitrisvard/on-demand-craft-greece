// microns-site: Static Assets, SEO handler, redirect table, sitemap routes, /api/* router.
// Phase 1 (PLAN.md §5.1, P1-1): preview only on *.workers.dev; nothing in production uses this Worker.
// Source: the "workers/site/wrangler.jsonc" object of docs/migration/wrangler.jsonc.draft. Phase 2 (PLAN.md §5.2)
// adds the /api port: OPS (microns-ops), PRIVATE_FILES, the three rate limits, the R2, legacy S3, forward, Access
// and gate vars, and the Phase 2 secrets. Phase 3 adds the routes.
//
// Secrets: NAMES ONLY. Set values with `npx wrangler secret put <NAME>` in this folder; for local runs put
// them in workers/site/.dev.vars (gitignored). The repository is public: never write a value here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microns-site",
  // Router order (src/index.ts): redirect table -> sitemap routes -> /api/* -> SEO handler for /{lang} and
  // /{lang}/* -> static (directory-index emulation, then env.ASSETS.fetch with the SPA fallback).
  "main": "src/index.ts",
  // Must stay >= 2025-04-01 (nodejs_compat populates process.env from that date on).
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Phase 1 serves only on microns-site.<WORKERS_SUBDOMAIN>.workers.dev, behind Cloudflare Access and always
  // with X-Robots-Tag: noindex (P1-7, src/preview.ts).
  "workers_dev": true,
  // Version and alias URLs for `wrangler versions upload --preview-alias staging` (P1-9).
  "preview_urls": true,
  // Workers Logs at full sampling: the Phase 3 gate needs "zero 5xx on SEO paths" as evidence.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Vite writes the build to <repo>/dist (vite.config.ts has no outDir); run `npx vite build` at the repo
  // root first. The path is relative to this folder.
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    // Exact file paths only: the default "auto-trailing-slash" would answer /index.html with a 307 to / and
    // /en with a 307 to /en/, which breaks URL parity and the shell fetch of the SEO handler.
    "html_handling": "none",
    // Unknown paths get /index.html with 200, like the Vercel fallback "/(.*)" -> "/index.html"
    // (vercel.json:158-161). Soft-404 parity (H-9); real 404s only from the Worker when seo.strict_404 is on.
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first, as middleware.ts runs before the prerendered files on Vercel (H-8).
    "run_worker_first": true
  },

  // Create the namespaces once and paste the printed IDs over the placeholders (IDs are not secrets):
  //   npx wrangler kv namespace create SEO_CACHE
  //   npx wrangler kv namespace create FLAGS
  // `wrangler dev --local` accepts the placeholders as they are (local namespaces are keyed by this string).
  "kv_namespaces": [
    // SEO row cache shared by all isolates, behind the per-isolate Map caches (src/seo/handler.ts).
    { "binding": "SEO_CACHE", "id": "<KV_ID_SEO_CACHE>" },
    // Feature flags, JSON {"enabled": true|false, ...} per key: seo.strict_404, api.forward_to_vercel
    // (src/flags.ts, src/api/forward.ts). Set by hand until Phase 4 mirrors table feature_flags into it.
    { "binding": "FLAGS", "id": "<KV_ID_FLAGS>" }
  ],

  // Phase 2: every /api endpoint except emails, s3 and marketing tracking runs in microns-ops, reached over RPC on
  // its named entrypoint OpsApi (src/api/ops-client.ts). microns-ops must be deployed before this Worker.
  "services": [
    { "binding": "OPS", "service": "microns-ops", "entrypoint": "OpsApi" }
  ],

  // Phase 2: customer files of /api/s3 (src/api/files.ts). The jurisdiction can only be chosen when the bucket is
  // created (wrangler r2 bucket create microns-private -J eu) and must equal R2_JURISDICTION in src/api/files.ts.
  "r2_buckets": [
    { "binding": "PRIVATE_FILES", "bucket_name": "microns-private", "jurisdiction": "eu" }
  ],

  // Phase 2: API rate limits (src/auth/rate-limit.ts). MAIL takes the mail keys, BULK idempotent reads and upload
  // presigns; both fall back to API_RATE_LIMIT when absent. A namespace_id shares its counters across Workers.
  "ratelimits": [
    { "name": "API_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_RATE_LIMIT_MAIL", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RATE_LIMIT_BULK", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
  ],

  "vars": {
    // Replaces the literal at middleware.ts:43 (a project URL, not a secret).
    "SUPABASE_URL": "https://cfjrtmtaitwzggzpkhxi.supabase.co",
    // Production origin: the only host that may receive Strict-Transport-Security (src/preview.ts).
    "SITE_ORIGIN": "https://www.micronshub.eu",
    // Comma-separated extra non-production hosts that get X-Robots-Tag: noindex. Every *.workers.dev host and
    // localhost get it anyway, so this stays empty until a custom preview host exists.
    "PREVIEW_HOSTNAMES": "",
    // Deploy-time default of flag seo.strict_404; an entry in KV FLAGS wins (SEO_PARITY.md §7). "false" keeps
    // soft-404 parity with Vercel (H-9) until PLAN.md Q5 is answered (P3-7).
    "SEO_STRICT_404": "false",
    // Target of the /api forward (src/api/forward.ts): paths outside the /api catalogue, and every /api request
    // while api.forward_to_vercel is on. The Vercel deployment host, not www: once the Phase 3 routes send www to
    // this Worker, the forward refuses to call its own host.
    "API_FORWARD_ORIGIN": "https://on-demand-craft-greece.vercel.app",
    // Router step 5: serve <dir>/index.html for /dir/ and /dir (public/laserkritis/, public/zohoverify/) as Vercel's
    // filesystem step is expected to. "true" until the P0-3 baseline says otherwise (SEO_PARITY.md G8 4-9, G9 10-11).
    "DIRECTORY_INDEX_EMULATION": "true",
    // HSTS_VALUE (optional): set to the Strict-Transport-Security value of the P0-3 baseline to have the
    // Worker emit it on the SITE_ORIGIN host. Left unset in Phase 1 (preview hosts never get it).

    // ----- Phase 2: /api port. Placeholders <...> are replaced by the owner with IDs and names (not secrets). -----
    // Fallback of the KV flag api.forward_to_vercel: "true" forwards every /api request to API_FORWARD_ORIGIN.
    // A var in .dev.vars is ignored while secrets.required exists: use `wrangler dev --var API_FORWARD_TO_VERCEL:true`.
    "API_FORWARD_TO_VERCEL": "false",
    // R2 S3 API endpoint https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com (presigned URLs, src/api/files.ts).
    "R2_ACCOUNT_ID": "<CF_ACCOUNT_ID>",
    // Legacy S3 store of files uploaded before the migration (read and delete; articles scope also upload).
    "LEGACY_S3_REGION": "eu-north-1",
    "LEGACY_S3_RFQ_BUCKET": "<LEGACY_S3_RFQ_BUCKET>",
    "LEGACY_S3_ARTICLES_BUCKET": "<LEGACY_S3_ARTICLES_BUCKET>",
    // Cloudflare Access team domain (x.cloudflareaccess.com) and the audience tag(s) of the Access application in
    // front of the API, for machine callers with a service token.
    "ACCESS_TEAM_DOMAIN": "<ACCESS_TEAM_DOMAIN>",
    "ACCESS_AUD": "<ACCESS_AUD_PREVIEW>",
    // Gate mode per class, "<class>=report|enforce" comma list; a class not named enforces. The production value is
    // set by the Phase 3 runbook.
    "API_GATES_MODE": "recipient=report",
    // Hosts besides the preview hosts that accept machine callers, comma list, exact match. Empty in Phase 2; the
    // Phase 3 runbook sets "api.micronshub.eu".
    "API_MACHINE_HOSTS": "",

    // ----- Phase 3/6 switches (top level = preview: every value selects the Phase 2 behaviour) -----
    // Article images of /api/s3 (src/api/articles-store.ts): "legacy" = legacy bucket; "r2" = the public R2 bucket.
    "ARTICLES_STORE": "legacy",
    // Origin of the public R2 bucket (its custom domain); used for article image URLs only when ARTICLES_STORE is "r2".
    "PUBLIC_FILES_ORIGIN": "https://files.micronshub.eu",
    // CORS of /api/* answers (src/preview.ts): "parity" = the vercel.json headers; "allowlist" = listed origins only.
    "API_CORS_MODE": "parity"
  },

  "secrets": {
    // Deploys and version uploads fail when a listed secret is missing on the Worker. Locally only these names
    // are loaded from .dev.vars (template: .dev.vars.example).
    "required": [
      "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "RESEND_API_KEY",
      "TURNSTILE_SECRET_KEY",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "LEGACY_AWS_ACCESS_KEY_ID",
      "LEGACY_AWS_SECRET_ACCESS_KEY",
      "ACCESS_MACHINE_CLIENT_IDS"
    ]
  },

  // Phase 3: the top level (every preview upload) never has routes; the production routes live in env.production below.
  "routes": [
    // { "pattern": "www.micronshub.eu/*", "zone_name": "micronshub.eu" },
    // { "pattern": "*.micronshub.eu/*", "zone_name": "micronshub.eu" }
  ],

  "env": {
    // Production of microns-site from runbook S11 on. Only .github/workflows/cf-site-production.yml and the owner's
    // own `--env production` commands select it; cf-preview.yml and `wrangler dev` use the top level.
    //
    // Rules (test/env-production.test.ts resolves both environments with wrangler's own reader and enforces them):
    //   - Keys wrangler inherits from the top level (main, compatibility_date/flags, assets, workers_dev,
    //     preview_urls, observability, limits) are NOT repeated here.
    //   - Keys wrangler does not inherit (vars, secrets, kv_namespaces, services, r2_buckets, ratelimits and every
    //     other binding) are repeated in full with the same values: a binding or var added to the top level must be
    //     added here too in the same change.
    //   - Only the vars of the "production values" group below may differ from the top level.
    //   - Preview and production versions belong to the same Worker and share its secrets. A site secret changes
    //     with `npx wrangler versions secret put <NAME> --env production`, then a production upload and deploy
    //     through the workflow; never with `wrangler secret put` or a plain `wrangler deploy`.
    "production": {
      // Without its own name, wrangler would deploy a second Worker called "microns-site-production".
      "name": "microns-site",
      // The most specific pattern wins: www first, then every other first-level host of the zone (tenants, api).
      // "*.micronshub.eu/*" does not match the apex, which the zone redirect rule answers. Inert until the records
      // are proxied (S12-S14). Every proxied host that this Worker must not answer gets a route without a Worker
      // before its record is proxied (scripts/phase3/payloads/zone-routes.json; the owner creates them).
      "routes": [
        { "pattern": "www.micronshub.eu/*", "zone_name": "micronshub.eu" },
        { "pattern": "*.micronshub.eu/*", "zone_name": "micronshub.eu" }
      ],
      "kv_namespaces": [
        { "binding": "SEO_CACHE", "id": "<KV_ID_SEO_CACHE>" },
        { "binding": "FLAGS", "id": "<KV_ID_FLAGS>" }
      ],
      "services": [
        { "binding": "OPS", "service": "microns-ops", "entrypoint": "OpsApi" }
      ],
      "r2_buckets": [
        { "binding": "PRIVATE_FILES", "bucket_name": "microns-private", "jurisdiction": "eu" }
      ],
      "ratelimits": [
        { "name": "API_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_RATE_LIMIT_MAIL", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_RATE_LIMIT_BULK", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
      ],
      "vars": {
        "SUPABASE_URL": "https://cfjrtmtaitwzggzpkhxi.supabase.co",
        "SITE_ORIGIN": "https://www.micronshub.eu",
        "PREVIEW_HOSTNAMES": "",
        "SEO_STRICT_404": "false",
        "API_FORWARD_ORIGIN": "https://on-demand-craft-greece.vercel.app",
        "DIRECTORY_INDEX_EMULATION": "true",
        "API_FORWARD_TO_VERCEL": "false",
        "R2_ACCOUNT_ID": "<CF_ACCOUNT_ID>",
        "LEGACY_S3_REGION": "eu-north-1",
        "LEGACY_S3_RFQ_BUCKET": "<LEGACY_S3_RFQ_BUCKET>",
        "LEGACY_S3_ARTICLES_BUCKET": "<LEGACY_S3_ARTICLES_BUCKET>",
        "ACCESS_TEAM_DOMAIN": "<ACCESS_TEAM_DOMAIN>",
        "PUBLIC_FILES_ORIGIN": "https://files.micronshub.eu",

        // ----- production values (the only vars allowed to differ from the top level) -----
        // Audiences of the preview Access app (the deployed version also answers on workers.dev) and of the
        // api.micronshub.eu Access app, comma list (src/auth/access.ts).
        "ACCESS_AUD": "<ACCESS_AUD_PREVIEW>,<ACCESS_AUD_API>",
        // Gate mode per class (Phase 2 D-16 default): both classes log and keep the current link and recipient
        // behaviour until the owner switches a class to "enforce".
        "API_GATES_MODE": "recipient=report,redirect=report",
        // Machine callers are accepted only on the Access-protected API host (Phase 2 D-3).
        "API_MACHINE_HOSTS": "api.micronshub.eu",
        // "r2" only after the owner has connected files.micronshub.eu to the public R2 bucket (P3-6 owner steps).
        "ARTICLES_STORE": "legacy",
        // "allowlist" only after the Phase 3 gate, preview first (P6-4).
        "API_CORS_MODE": "parity"
        // HSTS_VALUE: added only when scripts/phase3/redirect-rules.mjs reports "HSTS: worker = <value>" for the S11
        // baseline. Never a placeholder: whatever string is set here is sent as the header.
      },
      "secrets": {
        "required": [
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "RESEND_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "LEGACY_AWS_ACCESS_KEY_ID",
          "LEGACY_AWS_SECRET_ACCESS_KEY",
          "ACCESS_MACHINE_CLIENT_IDS"
        ]
      }
    }
  }
}

# =============================================================
# Environment variables template
# Copy this file to `.env` and fill in real values.
# NEVER commit real values — `.env` and `.env.*` are gitignored.
# =============================================================

# --- Supabase (client-side) ---
# The anon key is public by design (safe to ship to the browser).
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Supabase (server-side ONLY) ---
# Full-access key that bypasses RLS. Never prefix with VITE_ and never
# expose to the browser. Used by API routes, edge functions and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Personal access token for local tooling / the Supabase MCP server.
# Prefer exporting this in your shell rather than putting it in a file.
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here

# --- AWS S3 (server-side ONLY) ---
# Read by the /api/s3 function (api/s3.js), which signs every upload and
# download URL on the server. Never prefix these with VITE_: Vite ships
# VITE_ variables to the browser (vite.config.ts).
# The Cloudflare Workers use their own names (workers/site/.dev.vars.example).
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your_rfq_bucket_name_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Article images; the AWS_ARTICLES_* keys fall back to the keys above.
AWS_ARTICLES_BUCKET=your_articles_bucket_name_here
AWS_ARTICLES_ACCESS_KEY_ID=your_articles_access_key_id_here
AWS_ARTICLES_SECRET_ACCESS_KEY=your_articles_secret_access_key_here

# --- Cloudflare Turnstile (public site key) ---
# Cloudflare's always-pass test site key for local and preview builds; the
# real key is set only in the Worker build (no key: the forms render no
# widget and still submit).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- App ---
VITE_APP_ENV=development
VITE_APP_NAME=MicronsHub

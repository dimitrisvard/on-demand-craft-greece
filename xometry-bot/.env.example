# Copy to .env on the Hetzner box (gitignored). Never commit real values.

# Supabase Postgres (project cfjrtmtaitwzggzpkhxi). Direct connection shown; from
# GitHub Actions / any IPv4 host use the SESSION pooler string instead
# (postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres).
XB_DB_DSN=postgresql://postgres:<db-password>@db.cfjrtmtaitwzggzpkhxi.supabase.co:5432/postgres

# Partner API auth (§1A). Token = localStorage `authToken` on partner.xometry.eu.
# TODO(confirm): bearer vs cookie-only — set one or both; the first scan logs which works.
XB_PARTNER_AUTH_TOKEN=
XB_PARTNER_COOKIE=

# Bearer token the dashboard proxy must present to POST /submit|/skip. Generate a long random string.
XB_REVIEW_API_TOKEN=

# Where downloaded part files / screenshots / lockfile live.
XB_DATA_DIR=./data

# Persistent Playwright profiles (warm logged-in sessions; bootstrap with the `login` subcommands).
XB_BUYER_PROFILE_DIR=~/.xometry-bot/buyer-profile
XB_PARTNER_PROFILE_DIR=~/.xometry-bot/partner-profile

# Phase 2 gates (§5, §8.3): flip both to 1 only after `buyer_pricer probe` confirms the
# Order Value selector on one successful STEP quote.
XB_ENABLE_BUYER_PRICING=0
XB_BUYER_SELECTORS_CONFIRMED=0

XB_HEADLESS=1

# Download CAD/drawing files locally during the scan (needed only by the Phase-2
# buyer pricer). Set 0 for a serverless/CI scan — the dashboard links to
# Xometry's own downloadUrl. Default 1.
XB_DOWNLOAD_FILES=1

# Borderline ops to flip from "keep+flag" to "exclude" (§1C), comma-separated keywords,
# e.g. "grinding,heat treat". Default empty = CNC shop does them in-house.
XB_BORDERLINE_EXCLUDE=

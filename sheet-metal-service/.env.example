# Supabase project config (used to download STEP files via storage path)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: direct S3 creds if you prefer presigned URLs
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
S3_BUCKET=rfq-files
S3_REGION=us-east-1

# Optional shared secret — when set, incoming requests must include
# "X-API-Key: <API_KEY>" in headers. Leave empty during local dev.
API_KEY=
